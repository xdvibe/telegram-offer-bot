# Add these settings to your hosting service's environment-variable panel.
# This file documents the settings; the bot does not automatically load .env files.
BOT_TOKEN=YOUR_BOT_TOKEN
OWNER_IDS=123456789
LEADER_IDS=
ADMIN_IDS=
REQUIRED_CHANNEL=@your_channel
REQUIRED_CHANNEL_URL=https://t.me/your_channel
TON_WALLET=YOUR_TON_WALLET_ADDRESS
DEFAULT_RECIPIENT_USERNAME=@your_username
# Optional: set this to a mounted persistent directory on your host.
# BOT_DATA_DIR=/data
